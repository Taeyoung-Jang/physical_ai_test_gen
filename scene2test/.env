# Scene2Test environment variables.
# uv run / python -m will load this automatically when in the project root.

# Suppress pybullet GUI by default (set to "GUI" to enable).
PYBULLET_MODE=DIRECT

# Reproducibility seed for all random samplers.
SCENE2TEST_SEED=42

# Path to the scene library built by scene_generator.
SCENE_LIBRARY_DIR=data/scene_library

# Log level: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
