<mujoco model="g1_43dof scene with navigation target">
  <!-- Derived from scene_43dof.xml (see ../NOTICE.md for provenance) — identical except for
       the navigation_target body added before </worldbody>. Kept as a separate file rather
       than editing scene_43dof.xml in place, so the unmodified upstream copy stays available
       for comparison/rollback. -->
  <include file="g1_29dof_with_hand.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Third-person camera for visualization -->
    <camera name="global_view" pos="2.910 -5.040 3.860" xyaxes="0.866 0.500 0.000 -0.250 0.433 0.866" fovy="45"/>

    <!-- Navigation/pickup target (blueprint §14.3, and the pick-and-carry extension beyond it):
         robot spawns at the origin facing world +X (confirmed via offscreen head_camera
         forward-direction computation, no GUI needed — see src/g1_local_nav/scene_adapter.py).
         2.0m ahead, at the SAME (x, y) used everywhere else (task.target_x/target_y,
         G1Runtime.set_lateral_offset) — the xy-only navigation distance metric doesn't care
         about height, so raising the box changes nothing for Milestone 6 navigation, only adds
         reachability for grasping.

         Sits on a pedestal (below), NOT the floor: a standing G1's arm-only reach (no
         crouch/waist-bend scripted here — that would fight GrootLocomotionController's own
         whole-body balance) tops out around wrist z=0.71-0.85m depending on shoulder/elbow
         angles (headlessly grid-searched over right_shoulder_pitch/roll + right_elbow — see
         conversation record). A pedestal top at z=0.70 puts the box center at 0.85m, matching
         the best forward-reach pose found (shoulder_pitch=-0.8, elbow=1.4 -> wrist
         xpos≈(0.29, -0.11, 0.85) relative to standing at the origin).

         Has a freejoint (real 6-DOF rigid body, not fixed) so it can actually be picked up and
         carried, not just navigated to. mass="0.3" is an explicit override — the default
         density-based mass for a 0.3m solid cube would be ~27kg (way beyond what an arm-mounted
         weld constraint should be asked to carry); 0.3kg treats it as a light prop (e.g. a
         cardboard box), consistent with this whole project's "cheap honest proxy signal, not
         full fidelity" approach (see scene2test's kinematic oracle) applied to grasping. -->
    <body name="pickup_pedestal" pos="2.0 0.0 0.35">
      <geom name="pickup_pedestal_geom" type="box" size="0.2 0.2 0.35" rgba="0.5 0.35 0.2 1"/>
    </body>
    <body name="navigation_target" pos="2.0 0.0 0.85">
      <freejoint/>
      <geom name="navigation_target_geom" type="box" size="0.15 0.15 0.15" rgba="1 0 0 1" mass="0.3"/>
      <site name="navigation_target_site" pos="0 0 0"/>
    </body>
  </worldbody>

  <default>
    <geom friction="1.0"/>
  </default>

  <!-- Kinematic "grasp" via weld equality constraint (initially inactive). Not real
       contact/friction-based grasping — G1's fingers aren't actuated through this project's
       control interface at all (LeRobot's UnitreeG1.action_features only exposes arm .q
       targets + locomotion remote axes, no hand DDS channel). Grasping means: compute the
       object's current pose relative to right_wrist_yaw_link and write it into this
       constraint's relpose (G1Runtime.try_grasp()), then activate it — the object then moves
       rigidly with the wrist for as long as the constraint stays active, and releasing it drops
       the object exactly where it was let go, under normal physics. Verified headlessly before
       wiring into the real scene (rotating + translating carrier, object tracked correctly with
       no snap on activation, settled naturally on release — see conversation record). -->
  <equality>
    <weld name="grasp_weld" body1="right_wrist_yaw_link" body2="navigation_target" active="false"/>
  </equality>
</mujoco>
